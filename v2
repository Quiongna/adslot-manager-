<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/>
<title>AdSlot Manager — OOH · Lisboa</title>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css"/>
<style>
@import url('https://fonts.googleapis.com/css2?family=Instrument+Serif&display=swap');
:root{
  --bg:#faf8f4;--surface:#ffffff;--surface2:#f5f3ef;
  --border:rgba(20,18,26,0.08);--border2:rgba(20,18,26,0.18);
  --text:#14121a;--text2:#5b5663;--text3:#8e8a93;
  --accent:#5b3cff;--accent-l:rgba(91,60,255,0.06);--accent-m:#7a62ff;
  --green:#0f7a4a;--green-bg:rgba(15,122,74,0.08);--green-t:#0f7a4a;
  --amber:#b48a00;--amber-bg:#fff1c2;--amber-t:#b48a00;
  --red:#c0392b;--red-bg:rgba(192,57,43,0.07);--red-t:#c0392b;
  --blue:#1a5fd4;--blue-bg:rgba(26,95,212,0.07);--blue-t:#1a5fd4;
  --cred:#5b3cff;--cred-bg:rgba(91,60,255,0.07);--cred-t:#5b3cff;
  --r:8px;--r2:12px;--sh:none;
  --font-ui:'Geist',-apple-system,system-ui,sans-serif;
  --font-mono:'DM Mono','Geist Mono',ui-monospace,monospace;
  --font-display:'Instrument Serif','Times New Roman',serif;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font-ui);font-size:14px;background:var(--bg);color:var(--text);min-height:100vh;-webkit-font-smoothing:antialiased;}
input,select,button,textarea{font-family:inherit;font-size:13px}
input[type=text],input[type=number],input[type=date],select{padding:7px 11px;border:1px solid var(--border2);border-radius:6px;background:var(--surface);color:var(--text);width:100%;transition:border-color .15s;font-size:13px;}
input:focus,select:focus{outline:none;border-color:var(--accent)}
input[type=number]{width:auto}
button{padding:5px 14px;border:1px solid var(--border2);border-radius:999px;background:transparent;cursor:pointer;color:var(--text);font-weight:400;font-size:11px;font-family:var(--font-ui);transition:all .12s;line-height:1.4;}
button:hover{background:var(--surface2)}
.btn-p{background:var(--text);color:#fff;border-color:var(--text);}
.btn-p:hover{background:#2d2b35;border-color:#2d2b35}
.btn-g{background:var(--surface2);border-color:var(--border2);}
.btn-d{color:var(--red);border-color:rgba(192,57,43,0.2);}
.btn-d:hover{background:var(--red-bg)}
.btn-sm{padding:4px 10px;font-size:11px;}
.app{display:flex;min-height:100vh}
.sb{width:200px;min-height:100vh;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;position:sticky;top:0;max-height:100vh;overflow-y:auto;}
.sbh{padding:20px 18px 14px;border-bottom:1px solid var(--border);}
.sb-logo{font-family:var(--font-display);font-size:20px;letter-spacing:-.3px;}
.sb-sub{font-size:10px;color:var(--text3);font-family:var(--font-mono);letter-spacing:.8px;margin-top:2px;text-transform:uppercase;}
.sb-nav{padding:12px 10px;display:flex;flex-direction:column;gap:2px;}
.nb{width:100%;text-align:left;padding:7px 10px;border-radius:6px;font-size:12px;border:none;display:flex;align-items:center;gap:8px;color:var(--text2);}
.nb:hover{background:var(--surface2);color:var(--text)}
.nb.on{background:var(--accent-l);color:var(--accent);font-weight:600;}
.nb i{font-size:14px;flex-shrink:0}
.sbdiv{height:1px;background:var(--border);margin:6px 0;}
.nbb{pointer-events:none}
.mc{flex:1;padding:28px 30px;min-width:0;}
.pg{display:none}.pg.on{display:block}
.ptitle{font-family:var(--font-display);font-size:26px;letter-spacing:-.3px;margin-bottom:3px;}
.psub{font-size:12px;color:var(--text2);margin-bottom:18px;}
.card{background:var(--surface);border-radius:var(--r2);padding:20px;margin-bottom:14px;border:1px solid var(--border);}
.ctitle{font-weight:700;font-size:13px;margin-bottom:13px;color:var(--text);}
.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:16px 18px;}
.stat-v{font-family:var(--font-display);font-size:28px;letter-spacing:-.5px;}
.stat-l{font-family:var(--font-mono);font-size:9.5px;color:var(--text3);margin-top:5px;text-transform:uppercase;letter-spacing:1px;}
.stat-cr .stat-v{color:var(--cred);}
.fg{margin-bottom:12px}
.flbl{display:block;font-size:11px;font-weight:600;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.8px;color:var(--text2);margin-bottom:5px;}
.fhint{font-size:11px;color:var(--text3);margin-top:4px;}
.tgl-g{display:flex;flex-wrap:wrap;gap:7px;}
.tgl{padding:7px 13px;border-radius:999px;border:1px solid var(--border2);background:var(--surface2);cursor:pointer;font-size:12px;font-family:var(--font-ui);display:flex;align-items:center;gap:7px;transition:all .12s;text-align:left;}
.tgl.on{border-color:var(--accent);background:var(--accent-l);color:var(--accent);}
.tgl-off{opacity:.4;cursor:default;}
.al{display:flex;align-items:flex-start;gap:9px;padding:9px 13px;border-radius:8px;font-size:12px;line-height:1.5;margin-bottom:8px;}
.al i{flex-shrink:0;margin-top:1px;font-size:14px;}
.al-d{background:var(--red-bg);color:var(--red-t);}
.al-w{background:var(--amber-bg);color:var(--amber-t);}
.al-s{background:var(--green-bg);color:var(--green-t);}
.al-i{background:var(--blue-bg);color:var(--blue-t);}
.cr2{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--border);}
.cr2:last-child{border:none;padding-bottom:0;}
.badge{font-size:10px;font-family:var(--font-mono);padding:2px 7px;border-radius:99px;font-weight:600;margin-left:5px;letter-spacing:.3px;}
.b-ok{background:var(--green-bg);color:var(--green-t);}
.b-up{background:var(--blue-bg);color:var(--blue-t);}
.b-end{background:var(--surface2);color:var(--text3);}
.prog{height:3px;background:var(--surface2);border-radius:99px;margin-bottom:22px;}
.progf{height:100%;background:var(--accent);border-radius:99px;transition:width .3s;}
.step-h{font-size:15px;font-weight:700;margin-bottom:18px;display:flex;align-items:center;gap:10px;}
.step-n{width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;}
.swrp{display:flex;justify-content:space-between;align-items:center;margin-top:18px;padding-top:16px;border-top:1px solid var(--border);}
.ac{background:var(--surface2);border-radius:var(--r2);padding:11px 12px;border:1px solid var(--border);cursor:pointer;transition:border-color .12s;}
.ac:hover{border-color:var(--accent);}
.ag{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;}
.mini-bars{display:flex;gap:2px;align-items:flex-end;height:24px;margin:6px 0;}
.mini-bar{width:100%;border-radius:2px 2px 0 0;min-height:3px;}
.dr{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--border);}
.dr:last-child{border:none}
.dbar{flex:1;height:7px;background:var(--surface2);border-radius:4px;overflow:hidden;}
.dfil{height:100%;border-radius:4px;}
.av-hi{background:#bbf7d0}.av-mi{background:#fde68a}.av-lo{background:#fca5a5}.av-fx{background:#ddd6fe}.av-off{background:#f3f4f6;color:#9ca3af}
.zbadge{font-family:var(--font-mono);font-size:9.5px;padding:2px 7px;border-radius:5px;background:var(--accent-l);color:var(--accent);font-weight:600;margin-right:3px;letter-spacing:.3px;}
.chip{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-family:var(--font-mono);padding:2px 8px;border-radius:99px;background:var(--surface2);border:1px solid var(--border);margin:2px 2px 2px 0;}
.bd-dh{font-family:var(--font-mono);font-size:10px;font-weight:500;color:var(--text3);padding:5px 0;border-bottom:1px solid var(--border);margin-bottom:9px;text-transform:uppercase;letter-spacing:1.2px;}
.bd-c{background:var(--surface);border-radius:var(--r2);padding:12px 16px;margin-bottom:8px;border:1px solid var(--border);}
.kbw{margin-bottom:10px}
.kbt{display:flex;justify-content:space-between;font-size:11px;margin-bottom:5px;color:var(--text2);font-family:var(--font-mono)}
.kb{height:6px;background:var(--surface2);border-radius:4px;overflow:hidden}
.kbf{height:100%;border-radius:4px;transition:width .5s}
.stbl{width:100%;border-collapse:collapse;font-size:12px}
.stbl th{padding:8px 12px;background:var(--surface2);border:1px solid var(--border);text-align:left;font-weight:500;color:var(--text3);font-size:10px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.8px;}
.stbl td{padding:9px 12px;border:1px solid var(--border);vertical-align:middle}
.atbl{width:100%;border-collapse:collapse;font-size:12px;margin-bottom:16px}
.atbl th{padding:8px 10px;background:var(--accent-l);border:1px solid rgba(91,60,255,0.12);text-align:left;font-weight:500;color:var(--accent);font-size:10px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.8px;}
.atbl td{padding:8px 10px;border:1px solid var(--border);vertical-align:middle}
.atbl tr:nth-child(even) td{background:var(--surface2)}
.sec-lbl{font-family:var(--font-mono);font-weight:500;font-size:10px;color:var(--text3);margin-bottom:10px;margin-top:20px;padding-top:14px;border-top:1px solid var(--border);text-transform:uppercase;letter-spacing:1px;}
.cr-box{background:var(--cred-bg);border:1px solid rgba(91,60,255,0.15);border-radius:var(--r2);padding:14px 16px;margin-top:8px;}
.cr-big{font-family:var(--font-display);font-size:38px;font-weight:400;color:var(--cred);letter-spacing:-1px;}
.bsug{display:flex;gap:7px;margin-bottom:12px;flex-wrap:wrap}
.bsug-b{padding:5px 12px;border-radius:999px;border:1px solid var(--border2);background:var(--surface);cursor:pointer;font-size:11px;font-family:var(--font-mono);color:var(--text2);transition:all .12s;}
.bsug-b:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-l)}
.empty-st{text-align:center;padding:56px 24px;color:var(--text3);font-family:var(--font-mono)}
.empty-st i{font-size:40px;display:block;margin-bottom:14px;opacity:.3}
.dm-opts{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:7px}
.dm-opt{padding:10px 12px;border-radius:8px;border:1px solid var(--border);cursor:pointer;text-align:left;font-size:12px;background:var(--surface2);font-family:var(--font-ui);color:var(--text);transition:all .12s;}
.dm-opt.on{border-color:var(--accent);background:var(--accent-l)}
.warn-b{background:var(--amber-bg);color:var(--amber-t);font-size:9.5px;padding:2px 7px;border-radius:99px;font-weight:600;font-family:var(--font-mono);letter-spacing:.3px;}
.leg{font-size:11px;color:var(--text3);margin-bottom:10px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-family:var(--font-mono)}
.legd{width:9px;height:9px;border-radius:3px;display:inline-block;margin-right:4px;vertical-align:-1px}
.dinfo{font-family:var(--font-mono);font-size:11px;color:var(--blue-t);padding:9px 12px;background:var(--blue-bg);border-radius:8px;margin-bottom:11px;border:1px solid rgba(26,95,212,0.12);line-height:1.6;}
.sim-lay{display:grid;grid-template-columns:270px 1fr;gap:18px;align-items:start}
.sim-inp{background:var(--surface);border-radius:var(--r2);border:1px solid var(--border);padding:18px}
.sim-sec{margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.sim-sec:last-child{border:none;margin:0;padding:0}
.sim-stat{background:var(--surface2);border-radius:var(--r2);padding:14px 16px;border:1px solid var(--border)}
.sim-stat-v{font-family:var(--font-display);font-size:28px;font-weight:400;letter-spacing:-0.5px;}
.sim-stat-l{font-family:var(--font-mono);font-size:9.5px;color:var(--text3);margin-top:4px;text-transform:uppercase;letter-spacing:1px;}
.chk-row{display:flex;align-items:center;gap:8px;padding:8px 11px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);margin-bottom:5px;cursor:pointer;transition:all .12s;}
.chk-row.on{border-color:var(--accent);background:var(--accent-l)}
.chk-row input{width:auto;accent-color:var(--accent);flex-shrink:0}
.dtbl{width:100%;border-collapse:collapse;font-size:11px;font-family:var(--font-mono)}
.dtbl th{padding:7px 10px;background:var(--surface2);border:1px solid var(--border);text-align:left;font-weight:500;color:var(--text3);font-size:10px;text-transform:uppercase;letter-spacing:.8px;position:sticky;top:0;z-index:1;}
.dtbl td{padding:7px 10px;border:1px solid var(--border);vertical-align:middle}
.dtbl tr.warn-r td{background:#fffbeb}
.dtbl tr.bad-r td{background:rgba(192,57,43,0.04)}
.mota-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:3px;vertical-align:middle}
/* Scenario comparison table */
.sc-tbl{width:100%;border-collapse:collapse;font-size:12px;}
.sc-tbl th{padding:8px 11px;background:var(--surface2);border:1px solid var(--border);text-align:right;font-size:10px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.8px;color:var(--text3);}
.sc-tbl th:first-child{text-align:left;}
.sc-tbl td{padding:9px 11px;border:1px solid var(--border);text-align:right;vertical-align:middle;}
.sc-tbl td:first-child{text-align:left;font-weight:600;}
.sc-tbl tr.sc-active td{background:var(--accent-l);border-color:rgba(91,60,255,0.14);}
.sc-tbl tr:hover td{background:var(--surface2);}
/* Avail table */
.avt{width:100%;border-collapse:collapse;font-size:12px;min-width:600px;}
.avt th{padding:7px 10px;background:var(--surface2);border:1px solid var(--border);font-size:10px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.8px;color:var(--text3);}
.avt td{padding:7px 10px;border:1px solid var(--border);text-align:center;}
#sync-bar{position:fixed;top:0;left:0;right:0;background:var(--text);color:#fff;font-family:var(--font-mono);font-size:11px;font-weight:500;text-align:center;padding:8px;z-index:9999;display:none;letter-spacing:.5px;}
#sync-bar.err{background:var(--red)}
#sync-bar.ok{background:var(--green)}
@media print{.sb,.sim-inp,#sync-bar,.no-print{display:none!important}.sim-lay{grid-template-columns:1fr!important}body{background:#fff}.mc{padding:0}.dtbl{font-size:10px}}
</style>
</head>
<body>
<div id="sync-bar"></div>
<div class="app">

<nav class="sb">
  <div class="sbh"><div class="sb-logo">AdSlot</div><div class="sb-sub">OOH · Lisboa</div></div>
  <div class="sb-nav">
    <button class="nb on" data-v="dashboard" onclick="nav('dashboard')"><i class="ti ti-layout-dashboard"></i>Dashboard</button>
    <button class="nb" data-v="availability" onclick="nav('availability')"><i class="ti ti-calendar-stats"></i>Availability</button>
    <button class="nb" data-v="board" onclick="nav('board')"><i class="ti ti-calendar-week"></i>Board</button>
    <button class="nb" data-v="kpi" onclick="nav('kpi')"><i class="ti ti-chart-bar"></i>KPIs</button>
    <div class="sbdiv"></div>
    <button class="nb" data-v="campaigns" onclick="nav('campaigns')"><i class="ti ti-list"></i>Campaigns</button>
    <button class="nb" data-v="new_campaign" onclick="nav('new_campaign')"><i class="ti ti-plus"></i>New Campaign</button>
    <div class="sbdiv"></div>
    <button class="nb" data-v="sim" onclick="nav('sim')"><i class="ti ti-rocket"></i>Simulator</button>
    <div class="sbdiv"></div>
    <button class="nb" data-v="mainboard" onclick="nav('mainboard')"><i class="ti ti-settings"></i>Mainboard <span id="mb-warn" class="nbb warn-b" style="display:none">!</span></button>
  </div>
</nav>

<main class="mc">

<!-- DASHBOARD -->
<div id="pg-dashboard" class="pg on">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">
    <div class="ptitle">Dashboard</div>
    <div class="row" style="gap:9px">
      <div class="fg" style="margin:0"><label class="flbl">From</label><input type="date" id="dash-s" style="width:148px" onchange="rDash()"/></div>
      <div class="fg" style="margin:0"><label class="flbl">To</label><input type="date" id="dash-e" style="width:148px" onchange="rDash()"/></div>
    </div>
  </div>
  <div class="psub" id="dd-sub"></div>
  <div class="g4" id="ds" style="margin-bottom:14px"></div>
  <div class="card"><div class="ctitle">Occupancy by area</div><div class="ag" id="da"></div></div>
  <div class="card" id="dr-card"><div class="ctitle">Recent campaigns</div><div id="dr"></div></div>
</div>

<!-- AVAILABILITY -->
<div id="pg-availability" class="pg">
  <div class="ptitle">Availability</div><div class="psub">Available slots by area, date and time period.</div>
  <div class="card row" style="padding:14px 16px;gap:12px">
    <div class="fg" style="margin:0"><label class="flbl">Area</label><select id="av-a" onchange="rAvail()" style="width:200px"></select></div>
    <div class="fg" style="margin:0"><label class="flbl">From</label><input type="date" id="av-s" onchange="rAvail()" style="width:148px"/></div>
    <div class="fg" style="margin:0"><label class="flbl">To</label><input type="date" id="av-e" onchange="rAvail()" style="width:148px"/></div>
  </div>
  <div class="card" style="overflow-x:auto"><div class="leg" id="av-leg"></div><div id="av-grid"></div></div>
</div>

<!-- BOARD -->
<div id="pg-board" class="pg">
  <div class="ptitle">Board</div><div class="psub">Active campaigns day by day.</div>
  <div class="card row" style="padding:14px 16px;gap:12px">
    <div class="fg" style="margin:0"><label class="flbl">From</label><input type="date" id="bd-s" onchange="rBoard()" style="width:148px"/></div>
    <div class="fg" style="margin:0"><label class="flbl">To</label><input type="date" id="bd-e" onchange="rBoard()" style="width:148px"/></div>
    <div class="fg" style="margin:0"><label class="flbl">Client</label><select id="bd-cli" onchange="rBoard()" style="width:160px"></select></div>
    <div class="fg" style="margin:0"><label class="flbl">Area</label><select id="bd-area" onchange="rBoard()" style="width:174px"></select></div>
  </div>
  <div id="bd-list"></div>
</div>

<!-- KPIs -->
<div id="pg-kpi" class="pg">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">
    <div class="ptitle">KPIs</div>
    <div class="row" style="gap:9px">
      <div class="fg" style="margin:0"><label class="flbl">From</label><input type="date" id="kpi-s" onchange="rKPI()" style="width:148px"/></div>
      <div class="fg" style="margin:0"><label class="flbl">To</label><input type="date" id="kpi-e" onchange="rKPI()" style="width:148px"/></div>
    </div>
  </div>
  <div class="psub" id="kpi-sub"></div>
  <div class="g4" id="kpi-cards" style="margin-bottom:14px"></div>
  <div class="g2"><div class="card"><div class="ctitle">Revenue by area</div><div id="kpi-area"></div></div><div class="card"><div class="ctitle">Revenue by period</div><div id="kpi-period"></div></div></div>
  <div class="g2"><div class="card"><div class="ctitle">Pipeline</div><div id="kpi-pipe"></div></div><div class="card"><div class="ctitle">Utilisation today</div><div id="kpi-util"></div></div></div>
</div>

<!-- CAMPAIGNS -->
<div id="pg-campaigns" class="pg">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">
    <div class="ptitle">Campaigns</div>
    <div style="display:flex;gap:8px">
      <button onclick="exportCSV()" style="font-size:12px" class="no-print"><i class="ti ti-download"></i> CSV</button>
      <button class="btn-p no-print" onclick="nav('new_campaign')"><i class="ti ti-plus"></i> New</button>
    </div>
  </div>
  <div class="psub" id="csub"></div>
  <div class="card" id="clist"></div>
</div>

<!-- NEW / EDIT CAMPAIGN -->
<div id="pg-new_campaign" class="pg">
  <div class="ptitle" id="wiz-title">New campaign</div>
  <div class="psub" id="wl">Step 1 of 2</div>
  <div class="prog"><div class="progf" id="wp" style="width:50%"></div></div>
  <div class="card">
    <div id="s1">
      <div class="step-h"><span class="step-n">1</span>Info, areas &amp; period</div>
      <div class="g2">
        <div>
          <div class="fg"><label class="flbl">Campaign name</label><input id="fn" type="text" placeholder="e.g. Summer 2025" style="width:100%"/></div>
          <div class="fg"><label class="flbl">Client</label><input id="fc" type="text" placeholder="e.g. Brand XYZ" style="width:100%"/></div>
          <div class="fg" style="margin-bottom:0">
            <label class="flbl" style="margin-bottom:7px;display:block">Areas</label>
            <div class="tgl-g" id="asel"></div>
            <div id="asel-note" style="font-size:11px;color:var(--text2);margin-top:7px"></div>
          </div>
        </div>
        <div>
          <div class="g2" style="margin-bottom:12px">
            <div class="fg" style="margin:0"><label class="flbl">Start</label><input id="fs" type="date" oninput="updDur()" style="width:100%"/></div>
            <div class="fg" style="margin:0"><label class="flbl">End</label><input id="fe" type="date" oninput="updDur()" style="width:100%"/></div>
          </div>
          <div id="fdur" style="font-size:12px;color:var(--text2);margin-bottom:11px"></div>
          <label class="flbl" style="margin-bottom:7px;display:block">Time periods</label>
          <div class="tgl-g" id="psel"></div>
          <div id="psel-note" style="font-size:11px;color:var(--text2);margin-top:7px"></div>
        </div>
      </div>
    </div>
    <div id="s2" style="display:none">
      <div class="step-h"><span class="step-n">2</span>Budget, credits &amp; review</div>
      <div class="g2">
        <div>
          <div class="fg"><label class="flbl">Total budget (€)</label><input id="fb" type="number" step="0.01" min="0" placeholder="500.00" style="width:100%" oninput="updEst()"/><div class="fhint">1 credit = €<span id="cv-hint"></span> · <span id="cr-rate-hint"></span></div></div>
          <div class="fg"><label class="flbl">Suggestions</label><div class="bsug" id="bsug"></div></div>
          <div class="fg"><label class="flbl">Min slots/day <span style="font-weight:400;color:var(--text3)">(per area)</span></label><input id="fmd" type="number" step="1" min="1" value="10" style="width:100%" oninput="updEst()"/></div>
          <div class="dinfo" id="distinfo"></div>
          <div id="estalerts"></div>
        </div>
        <div>
          <div id="estzone" style="display:none">
            <div class="cr-box" style="margin-bottom:12px"><div class="cr-big" id="est-cr">—</div><div style="font-size:11px;color:#6d28d9;margin-top:2px" id="est-cr-sub">total credits</div></div>
            <div class="g2" id="estg" style="margin-bottom:12px"></div>
            <div id="est-cpm" style="font-size:12px;color:var(--text2);padding:9px 12px;background:var(--surface2);border-radius:var(--r)"></div>
          </div>
          <div id="estzone-empty" style="text-align:center;padding:30px 0;color:var(--text3)"><i class="ti ti-calculator" style="font-size:36px;display:block;margin-bottom:8px;opacity:.4"></i><div style="font-size:12px">Fill in the budget to see the estimate</div></div>
        </div>
      </div>
      <div id="review-zone" style="display:none">
        <div class="sec-lbl">Review by area</div>
        <div id="ral" style="margin-bottom:8px"></div>
        <div id="rdist"></div>
      </div>
    </div>
    <div class="swrp">
      <button id="wb" onclick="wBack()">Cancel</button>
      <div style="display:flex;gap:8px">
        <button id="wp-prev" onclick="wPrev()" style="display:none">← Back</button>
        <button id="wn" class="btn-p" onclick="wNext()">Next →</button>
      </div>
    </div>
  </div>
</div>

<!-- SIMULATOR -->
<div id="pg-sim" class="pg">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
    <div class="ptitle">🚀 Simulator</div>
    <div id="sim-xbtns" style="display:none;gap:8px" class="no-print">
      <button onclick="simExportCSV()" style="font-size:12px"><i class="ti ti-download"></i> CSV</button>
      <button onclick="window.print()" style="font-size:12px"><i class="ti ti-printer"></i> PDF</button>
    </div>
  </div>
  <div class="psub">Simulate real slot delivery day by day, accounting for available screens, active campaigns and client criteria.</div>
  <div class="sim-lay">
    <div class="sim-inp">
      <div class="sim-sec">
        <div class="ctitle">Client contract</div>
        <div class="fg">
          <label class="flbl">Total budget (€)</label>
          <input type="number" id="sim-budget" step="0.01" min="0.01" placeholder="e.g. 5000.00" oninput="simLive()" style="width:100%"/>
          <div class="fhint" id="sim-budget-hint"></div>
        </div>
        <div class="g2" style="margin-bottom:8px">
          <div class="fg" style="margin:0"><label class="flbl">Start</label><input type="date" id="sim-s" oninput="simLive()" style="width:100%"/></div>
          <div class="fg" style="margin:0"><label class="flbl">End</label><input type="date" id="sim-e" oninput="simLive()" style="width:100%"/></div>
        </div>
        <div id="sim-dur" style="font-size:12px;color:var(--text2)"></div>
      </div>
      <div class="sim-sec">
        <div class="ctitle">Areas / Screens</div>
        <div id="sim-asel"></div>
      </div>
      <div class="sim-sec">
        <div class="ctitle">Time periods</div>
        <div id="sim-psel"></div>
      </div>
      <div class="sim-sec">
        <div class="ctitle">Criteria</div>
        <div class="fg"><label class="flbl">Min slots/day <span style="font-weight:400;color:var(--text3)">(per area)</span></label><input type="number" id="sim-min" step="1" min="1" value="10" style="width:100%"/></div>
        <div class="fg" style="margin-bottom:14px">
          <label class="flbl">Distribution mode</label>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:5px" id="sim-dm-btns">
            <button class="sim-dm" data-dm="weighted" onclick="simPickDM(this)" style="padding:8px 7px;font-size:10px;border-radius:var(--r);border:1.5px solid var(--border);background:var(--surface2);cursor:pointer;text-align:left;line-height:1.4">📈 Peak-weighted<br><span style="opacity:.6;font-size:9px">More slots at peak times</span></button>
            <button class="sim-dm" data-dm="even" onclick="simPickDM(this)" style="padding:8px 7px;font-size:10px;border-radius:var(--r);border:1.5px solid var(--border);background:var(--surface2);cursor:pointer;text-align:left;line-height:1.4">➡️ Even / hour<br><span style="opacity:.6;font-size:9px">Same slots each hour</span></button>
            <button class="sim-dm" data-dm="even_area" onclick="simPickDM(this)" style="padding:8px 7px;font-size:10px;border-radius:var(--r);border:1.5px solid var(--border);background:var(--surface2);cursor:pointer;text-align:left;line-height:1.4">⊙ Equal / area<br><span style="opacity:.6;font-size:9px">Same total per area</span></button>
            <button class="sim-dm" data-dm="even_area_hour" onclick="simPickDM(this)" style="padding:8px 7px;font-size:10px;border-radius:var(--r);border:1.5px solid var(--border);background:var(--surface2);cursor:pointer;text-align:left;line-height:1.4">⊞ Equal / hr &amp; area<br><span style="opacity:.6;font-size:9px">Fully uniform</span></button>
          </div>
        </div>
        <button class="btn-p" style="width:100%;padding:10px;font-size:13px" onclick="runSim()"><i class="ti ti-play"></i> Run Simulation</button>
      </div>
    </div>
    <div>
      <div id="sim-empty" class="card" style="text-align:center;padding:60px 24px;color:var(--text3)">
        <i class="ti ti-rocket" style="font-size:48px;display:block;margin-bottom:14px;opacity:.3"></i>
        <div style="font-weight:700;font-size:16px;color:var(--text2);margin-bottom:8px">Configure and simulate</div>
        <div style="font-size:13px;line-height:1.7">Fill in the parameters on the left<br>and click <strong>Run Simulation</strong>.</div>
      </div>
      <div id="sim-out" style="display:none">
        <div id="sim-summary" class="g4" style="margin-bottom:14px"></div>
        <div id="sim-alerts" style="margin-bottom:14px"></div>
        <!-- Scenario comparison -->
        <div class="card" style="margin-bottom:14px">
          <div class="ctitle">Distribution mode comparison</div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:12px">Same budget across all 4 modes — <strong>highlighted row</strong> = current simulation mode.</div>
          <div style="overflow-x:auto"><table class="sc-tbl" id="sim-scenario-tbl"></table></div>
        </div>
        <!-- Burndown -->
        <div class="card" style="margin-bottom:14px">
          <div class="ctitle">Budget burndown — day by day</div>
          <div style="overflow-x:auto"><svg id="sim-svg" height="180" style="width:100%;min-width:400px;border-radius:var(--r);border:1px solid var(--border)"></svg></div>
          <div id="sim-leg" style="display:flex;gap:14px;margin-top:8px;font-size:11px;color:var(--text2);flex-wrap:wrap"></div>
        </div>
        <!-- Screens -->
        <div class="card" style="margin-bottom:14px">
          <div class="ctitle">Screens by area</div>
          <div id="sim-motas" style="display:flex;flex-wrap:wrap;gap:10px"></div>
        </div>
        <!-- Day table -->
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
            <div class="ctitle" style="margin:0">Day-by-day calendar</div>
            <div style="display:flex;gap:6px" class="no-print">
              <button class="btn-sm btn-g" onclick="simToggle()"><i class="ti ti-eye"></i> <span id="sim-tgl-lbl">Show all</span></button>
              <button class="btn-sm btn-g" onclick="simExportCSV()"><i class="ti ti-download"></i> CSV</button>
              <button class="btn-sm btn-g" onclick="window.print()"><i class="ti ti-printer"></i> PDF</button>
            </div>
          </div>
          <div style="overflow-x:auto;max-height:440px;overflow-y:auto">
            <table class="dtbl" id="sim-tbl">
              <thead><tr>
                <th>Date</th><th>Day</th><th>Screens</th><th style="text-align:right">Slots/day</th>
                <th style="text-align:right">Cap.%</th><th style="text-align:right">Budget</th>
                <th style="text-align:right">Credits</th><th style="text-align:right">Impressions</th>
                <th style="text-align:right">Remaining</th><th style="text-align:center">Status</th>
              </tr></thead>
              <tbody id="sim-tbody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
